# Copy to .env and edit; .env is not committed. The values below are the amd64
# machine's; on the arm64 branch the example is 100.64.0.30 / fb-arm64.

# --- required ---
# This machine's Tailscale address: everything is published on it only.
HOST_IP=100.64.0.7
# Long random key shared by File Browser and Syncthing, e.g.:
#   echo "SYNCTHING_API_KEY=$(openssl rand -hex 24)" >> .env
SYNCTHING_API_KEY=change-me

# --- the folder that is served and synced (mounted at /srv in both containers) ---
DATA_DIR=/root

# --- ports on HOST_IP (host side only; the container ports never change) ---
# File Browser
WEB_PORT=38002
# Syncthing's own web interface (no password until you set one in its settings)
SYNCTHING_GUI_PORT=38003
# Where other devices connect (TCP + UDP); use the same value on every machine,
# it is also the port assumed when a device address is entered without one.
SYNC_PORT=23000
# Syncthing local discovery (UDP, idle while discovery is off)
DISCOVERY_PORT=23001

# --- other ---
# The device name the other side sees; differs per machine.
SYNCTHING_NAME=fb-amd64
# The user the containers run as (0 = root, needed to serve root-owned files).
PUID=0
PGID=0

# Optional: pin the File Browser image to a release instead of the moving tag.
# Use <version>-amd64 on the amd64 machine and <version>-arm64 on the arm64 one
# (versions are listed in CHANGES.md).
# FB_TAG=2.63.23-fork.2-amd64
