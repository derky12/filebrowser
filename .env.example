# Copy to .env and edit, or let scripts/init-env.sh write it. .env is not
# committed. Put comments on their own lines, not after a value.
# echo "SYNCTHING_API_KEY=$(openssl rand -hex 24)" >> .env

# 修改名字
SYNCTHING_NAME=main-aus-debian
# 修改arch
ARCH=amd64
# 修改host ip
HOST_IP=100.64.0.7
SYNC_PORT=23000
DISCOVERY_PORT=23001
DATA_DIR=/root
WEB_PORT=38002
SYNCTHING_GUI_PORT=38003
PUID=0
PGID=0

# --- WebDAV (optional): share folders from the web interface ---
# Right click a folder > Share as WebDAV. Set WEBDAV_ENABLED=true and a
# password of at least 8 characters (scripts/init-env.sh makes one) to turn it on.
WEBDAV_ENABLED=false
WEBDAV_USER=webdav
WEBDAV_PASSWORD=
# Where the port is published: the Tailscale address to reach it directly, or
# 127.0.0.1 when an HTTPS proxy on this machine sits in front of it.
WEBDAV_BIND_IP=100.64.0.7
WEBDAV_PORT=38004
# Only with an HTTPS reverse proxy in front (see the README):
# the address clients use, a sub-path if it is served under one, and whether
# to trust X-Forwarded-For. Leave empty / false without a proxy.
WEBDAV_PUBLIC_URL=
WEBDAV_PREFIX=
WEBDAV_BEHIND_PROXY=false
