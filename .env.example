# Copy to .env and set a long random value:
#   echo "SYNCTHING_API_KEY=$(openssl rand -hex 24)" > .env
SYNCTHING_API_KEY=change-me

# Host ports of Syncthing (published on the Tailscale address). Optional.
# SYNC_PORT is where other devices connect; use the same value on every machine.
# DISCOVERY_PORT is Syncthing's local-discovery port (idle while discovery is off).
SYNC_PORT=23000
DISCOVERY_PORT=23001
